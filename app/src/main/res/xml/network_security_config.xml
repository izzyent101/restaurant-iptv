<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV providers frequently serve over plain HTTP, and the embedded
     control server is HTTP on the LAN. Allow cleartext broadly; the
     control server is only reachable on the local network / Tailscale. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
