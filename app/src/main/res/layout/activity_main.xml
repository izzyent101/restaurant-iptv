<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#B3000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Brief channel info on zapping (bottom-left) -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:paddingHorizontal="22dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:contentDescription="logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infoNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="560dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#CFE0F2"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Browse overlay: video stays full-screen; list floats over a left gradient -->
    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/categoryColumn"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F2070A0E"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="14dp"
                android:text="CATEGORIES"
                android:textColor="#8B98A5"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="18dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="52"
            android:orientation="vertical"
            android:background="@drawable/scrim_left">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|bottom"
                android:paddingHorizontal="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/channelHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Channels"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#6B7683"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/browserHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:text="OK  Play        ◄  Categories        Hold OK  ★ Favorite"
                android:textColor="#6B7683"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Transparent — the full-screen video shows through here -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48" />
    </LinearLayout>

    <!-- Recently-watched strip (bottom), opened with OK -->
    <LinearLayout
        android:id="@+id/historyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/scrim_bottom"
        android:paddingTop="44dp"
        android:paddingBottom="26dp"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RECENTLY WATCHED"
                android:textColor="#8B98A5"
                android:textSize="13sp"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/historyClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/row_pill"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="✕  Clear"
                android:textColor="#FF8B84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="26dp"
            android:text="Nothing watched yet — play a channel and it'll show up here."
            android:textColor="#6B7683"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            android:clipToPadding="false"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- Cold-start splash: backlit emblem holds briefly, then fades into playback -->
    <ImageView
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:scaleType="centerInside"
        android:src="@drawable/splash_logo"
        android:contentDescription="MMG TV" />
</FrameLayout>
