<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_pill"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="66dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <ImageView
        android:id="@+id/chLogo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="14dp"
        android:scaleType="fitCenter"
        android:contentDescription="logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/row_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/row_sub"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/chStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="★"
        android:textColor="#E3B341"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:text="▶"
        android:textColor="@color/row_arrow"
        android:textSize="13sp" />
</LinearLayout>
